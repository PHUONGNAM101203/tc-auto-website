# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Anh so sanh do chinh xac pixel (sinh lai bang: npm run verify:fidelity)
/tools/fidelity/out/
# Ket qua Playwright
/test-results/
/playwright-report/
coverage/
tsconfig.tsbuildinfo

# Sơ đồ tri thức dự án (graphify). Dựng lại bằng:
#   graphify update .          (không cần LLM, không tốn gì)
#   graphify cluster-only .    (đặt tên cụm, cần đăng nhập Claude)
#
# Chỉ GRAPH_REPORT.md được đưa lên kho — nó đọc được và đáng để xem lịch sử.
# Các tệp còn lại là dữ liệu dẫn xuất và nặng: graph.json 1,7MB, graph.html
# 1,4MB, cache 1,4MB, và mỗi lần chạy lại đẻ thêm một thư mục sao lưu theo ngày.
graphify-out/*
!graphify-out/GRAPH_REPORT.md

# Ban xuat du lieu Supabase — CO DU LIEU CA NHAN, khong bao gio len git.
.backup/
